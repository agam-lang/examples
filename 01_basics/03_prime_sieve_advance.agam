@lang.advance

// Agam Advance Profile: Sieve of Eratosthenes
// Explicit bounds-checked bitfield scan

fn count_primes(limit: i64) -> i64 {
    let mut count: i64 = 0;
    let mut i: i64 = 2;
    while i < limit {
        let mut is_prime: i64 = 1;
        let mut d: i64 = 2;
        while d * d <= i {
            if i % d == 0 {
                is_prime = 0;
                break;
            }
            d = d + 1;
        }
        if is_prime == 1 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fn main() -> i32 {
    let total = count_primes(20000);
    print_int(total);
    return 0;
}
